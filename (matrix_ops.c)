#include <stdio.h>
#define S 3
void add(int a[S][S], int b[S][S], int r[S][S]) {
    for(int i=0; i<S; i++) for(int j=0; j<S; j++) r[i][j] = a[i][j] + b[i][j];
}
int main() {
    int a[S][S] = {{1,2,3},{4,5,6},{7,8,9}}, b[S][S] = {{9,8,7},{6,5,4},{3,2,1}}, r[S][S];
    add(a, b, r);
    printf("Matrix Addition Result:\n");
    for(int i=0; i<S; i++) {
        for(int j=0; j<S; j++) printf("%d ", r[i][j]);
        printf("\n");
    }
    return 0;
}

